generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TenantRole {
  TENANT_ADMIN
  OPERATOR
  QUALITY_ENGINEER
  ACTION_OWNER
  AUDITOR
}

enum CaseStatus {
  DRAFT
  SUBMITTED
  TRIAGE
  INVESTIGATING
  ACTION_IN_PROGRESS
  VERIFICATION_PENDING
  REOPENED
  CLOSED
  CANCELLED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FindingKind {
  FACT
  AI_HYPOTHESIS
  TESTED
  CONFIRMED
}

enum EvidenceStatus {
  UPLOAD_PENDING
  UPLOADED_UNVERIFIED
  AVAILABLE
  UPLOAD_FAILED
  ARCHIVED
}

enum EvidenceType {
  DEFECT_PHOTO
  MEASUREMENT
  PROCESS_RECORD
  ACTION_PROOF
  VERIFICATION_PROOF
  OTHER
}

enum ActionType {
  CONTAINMENT
  CORRECTIVE
  PREVENTIVE
}

enum ActionStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EffectivenessOutcome {
  EFFECTIVE
  NOT_EFFECTIVE
  INCONCLUSIVE
}

enum SuggestionType {
  CASE_FIELDS
  INVESTIGATION_QUESTIONS
  CAUSE_HYPOTHESES
}

enum SuggestionStatus {
  QUEUED
  RUNNING
  READY
  INVALID_OUTPUT
  FAILED
  ACCEPTED
  EDITED
  REJECTED
}

enum ActorType {
  USER
  SYSTEM
  WORKER
}

enum ReportStatus {
  QUEUED
  RUNNING
  READY
  FAILED
}

enum OutboxStatus {
  PENDING
  DISPATCHED
  FAILED
}


model User {
  id                  String       @id @default(cuid())
  authSubject         String       @unique
  email               String       @unique
  displayName         String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  memberships         Membership[]
  reportedCases       QualityCase[] @relation("CaseReporter")
  triagedCases        QualityCase[] @relation("CaseTriageOwner")
  closedCases         QualityCase[] @relation("CaseCloser")
  uploadedFiles       CaseEvidence[] @relation("EvidenceUploader")
  createdFindings     Finding[]     @relation("FindingCreator")
  confirmedFindings   Finding[]     @relation("FindingConfirmer")
  createdActions      Action[]      @relation("ActionCreator")
  completedActions    Action[]      @relation("ActionCompleter")
  assignedActions     Action[]      @relation("ActionAssignee")
  verifiedChecks      EffectivenessCheck[] @relation("EffectivenessReviewer")
  comments            CaseComment[]
  auditEvents         AuditEvent[]  @relation("AuditActor")
  aiRequests          AiSuggestion[] @relation("AiRequester")
  aiDecisions         AiSuggestion[] @relation("AiDecider")
  reports             CaseReport[]  @relation("ReportRequester")
  outboxEvents        OutboxEvent[] @relation("OutboxActor")
}

model Tenant {
  id                    String       @id @default(cuid())
  name                  String
  slug                  String       @unique
  isActive              Boolean      @default(true)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  memberships           Membership[]
  sites                 Site[]
  cases                 QualityCase[]
  evidence              CaseEvidence[]
  findings              Finding[]
  investigations        Investigation[]
  whySteps              WhyStep[]
  actions               Action[]
  effectivenessChecks   EffectivenessCheck[]
  comments              CaseComment[]
  auditEvents           AuditEvent[]
  aiSuggestions         AiSuggestion[]
  reports               CaseReport[]
  outboxEvents          OutboxEvent[]
}

model Membership {
  id        String     @id @default(cuid())
  tenantId  String
  userId    String
  role      TenantRole
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId, isActive])
  @@index([tenantId, role, isActive])
}

model Site {
  id        String        @id @default(cuid())
  tenantId  String
  name      String
  code      String?
  timezone  String        @default("Asia/Kolkata")
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cases     QualityCase[]

  @@unique([id, tenantId])
  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model QualityCase {
  id                    String      @id @default(cuid())
  tenantId              String
  siteId                String
  caseNumber            String
  title                 String
  description           String
  category              String?
  severity              Severity    @default(MEDIUM)
  status                CaseStatus  @default(DRAFT)
  partNumber            String?
  machineId             String?
  operation             String?
  observedValue         Decimal?    @db.Decimal(18, 6)
  unit                  String?
  specification         String?
  quantityInspected     Int?
  quantityAffected      Int?
  reportedById          String
  triageOwnerId         String?
  closedById            String?
  containmentAssessment String?
  cancellationReason    String?
  reopenReason          String?
  version               Int         @default(1)
  submittedAt           DateTime?
  closedAt              DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  tenant                Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  site                  Site        @relation(fields: [siteId, tenantId], references: [id, tenantId], onDelete: Restrict)
  reportedBy            User        @relation("CaseReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  triageOwner           User?       @relation("CaseTriageOwner", fields: [triageOwnerId], references: [id], onDelete: SetNull)
  closedBy              User?       @relation("CaseCloser", fields: [closedById], references: [id], onDelete: SetNull)
  evidence              CaseEvidence[]
  findings              Finding[]
  investigations        Investigation[]
  actions               Action[]
  effectivenessChecks   EffectivenessCheck[]
  comments              CaseComment[]
  auditEvents           AuditEvent[]
  aiSuggestions         AiSuggestion[]
  reports               CaseReport[]
  outboxEvents          OutboxEvent[]

  @@unique([id, tenantId])
  @@unique([tenantId, caseNumber])
  @@index([tenantId, status, updatedAt])
  @@index([tenantId, siteId, createdAt])
  @@index([tenantId, category, status])
  @@index([tenantId, reportedById, createdAt])
}

model CaseEvidence {
  id                 String         @id @default(cuid())
  tenantId           String
  caseId             String
  uploadedById       String
  objectKey          String         @unique
  originalFileName   String
  contentType        String
  byteSize           BigInt
  sha256              String?
  evidenceType       EvidenceType   @default(OTHER)
  status             EvidenceStatus @default(UPLOAD_PENDING)
  caption            String?
  createdAt          DateTime       @default(now())
  finalizedAt        DateTime?
  archivedAt         DateTime?
  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case               QualityCase    @relation(fields: [caseId, tenantId], references: [id, tenantId], onDelete: Restrict)
  uploadedBy         User           @relation("EvidenceUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  findingLinks       FindingEvidence[]
  whyStepLinks       WhyStepEvidence[]
  actionLinks        ActionEvidence[]
  effectivenessLinks EffectivenessEvidence[]

  @@unique([id, tenantId])
  @@index([tenantId, caseId, createdAt])
  @@index([tenantId, status])
}

model Finding {
  id                    String      @id @default(cuid())
  tenantId              String
  caseId                String
  kind                  FindingKind
  statement             String
  createdById           String
  confirmedById         String?
  confirmationRationale String?
  confirmedAt           DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  tenant                Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case                  QualityCase @relation(fields: [caseId, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdBy             User        @relation("FindingCreator", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedBy           User?       @relation("FindingConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  evidenceLinks         FindingEvidence[]

  @@unique([id, tenantId])
  @@index([tenantId, caseId, kind])
}

model FindingEvidence {
  id         String       @id @default(cuid())
  tenantId   String
  findingId  String
  evidenceId String
  createdAt  DateTime     @default(now())
  finding    Finding      @relation(fields: [findingId, tenantId], references: [id, tenantId], onDelete: Cascade)
  evidence   CaseEvidence @relation(fields: [evidenceId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([tenantId, findingId, evidenceId])
  @@index([tenantId, evidenceId])
}

model Investigation {
  id        String      @id @default(cuid())
  tenantId  String
  caseId    String
  title     String?
  summary   String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case      QualityCase @relation(fields: [caseId, tenantId], references: [id, tenantId], onDelete: Cascade)
  whySteps  WhyStep[]

  @@unique([id, tenantId])
  @@unique([tenantId, caseId])
  @@index([tenantId, caseId])
}

model WhyStep {
  id              String        @id @default(cuid())
  tenantId        String
  investigationId String
  stepNumber      Int
  question        String
  answer          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  investigation   Investigation @relation(fields: [investigationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  evidenceLinks   WhyStepEvidence[]

  @@unique([tenantId, investigationId, stepNumber])
  @@unique([id, tenantId])
  @@index([tenantId, investigationId])
}

model WhyStepEvidence {
  id         String       @id @default(cuid())
  tenantId   String
  whyStepId  String
  evidenceId String
  createdAt  DateTime     @default(now())
  whyStep    WhyStep      @relation(fields: [whyStepId, tenantId], references: [id, tenantId], onDelete: Cascade)
  evidence   CaseEvidence @relation(fields: [evidenceId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([tenantId, whyStepId, evidenceId])
}

model Action {
  id              String       @id @default(cuid())
  tenantId        String
  caseId          String
  actionType      ActionType
  title           String?
  description     String
  assigneeId      String
  dueAt           DateTime
  status          ActionStatus @default(OPEN)
  isRequired      Boolean      @default(true)
  createdById     String
  completedById   String?
  completionNote  String?
  completedAt     DateTime?
  cancelledReason String?
  version         Int          @default(1)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case            QualityCase  @relation(fields: [caseId, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdBy       User         @relation("ActionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignee        User         @relation("ActionAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  completedBy     User?        @relation("ActionCompleter", fields: [completedById], references: [id], onDelete: Restrict)
  proofLinks      ActionEvidence[]

  @@unique([id, tenantId])
  @@index([tenantId, assigneeId, status, dueAt])
  @@index([tenantId, caseId, status])
}

model ActionEvidence {
  id         String       @id @default(cuid())
  tenantId   String
  actionId   String
  evidenceId String
  createdAt  DateTime     @default(now())
  action     Action       @relation(fields: [actionId, tenantId], references: [id, tenantId], onDelete: Cascade)
  evidence   CaseEvidence @relation(fields: [evidenceId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([tenantId, actionId, evidenceId])
  @@index([tenantId, evidenceId])
}

model EffectivenessCheck {
  id                  String               @id @default(cuid())
  tenantId            String
  caseId              String
  criterion           String
  samplePlan          String?
  sampleSize          Int?
  outOfToleranceCount Int?
  acceptableFailures  Int?
  measurementWindow   String?
  outcome             EffectivenessOutcome
  reviewerComment     String?
  reviewerId          String
  reviewedAt          DateTime             @default(now())
  caseVersionAtReview Int
  createdAt           DateTime             @default(now())
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case                QualityCase          @relation(fields: [caseId, tenantId], references: [id, tenantId], onDelete: Cascade)
  reviewer            User                 @relation("EffectivenessReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  evidenceLinks       EffectivenessEvidence[]

  @@unique([id, tenantId])
  @@index([tenantId, caseId, reviewedAt])
}

model EffectivenessEvidence {
  id                   String             @id @default(cuid())
  tenantId             String
  effectivenessCheckId String
  evidenceId           String
  createdAt             DateTime           @default(now())
  effectivenessCheck   EffectivenessCheck @relation(fields: [effectivenessCheckId, tenantId], references: [id, tenantId], onDelete: Cascade)
  evidence             CaseEvidence       @relation(fields: [evidenceId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([tenantId, effectivenessCheckId, evidenceId])
}

model CaseComment {
  id        String      @id @default(cuid())
  tenantId  String
  caseId    String
  authorId  String
  body      String
  createdAt DateTime    @default(now())
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case      QualityCase @relation(fields: [caseId, tenantId], references: [id, tenantId], onDelete: Cascade)
  author    User        @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([tenantId, caseId, createdAt])
}

model AiSuggestion {
  id             String           @id @default(cuid())
  tenantId       String
  caseId         String
  requestedById  String
  decidedById    String?
  suggestionType SuggestionType
  status         SuggestionStatus @default(QUEUED)
  provider       String?
  model          String?
  promptVersion  String
  schemaVersion  String           @default("1")
  inputHash      String
  outputJson     Json?
  decisionJson   Json?
  decisionNote   String?
  requestedAt    DateTime         @default(now())
  completedAt    DateTime?
  decidedAt      DateTime?
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case           QualityCase      @relation(fields: [caseId, tenantId], references: [id, tenantId], onDelete: Cascade)
  requestedBy    User             @relation("AiRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy      User?            @relation("AiDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, caseId, requestedAt])
  @@index([tenantId, status, requestedAt])
}

model CaseReport {
  id            String       @id @default(cuid())
  tenantId      String
  caseId        String
  requestedById String
  status        ReportStatus @default(QUEUED)
  caseVersion   Int
  objectKey     String?      @unique
  checksumSha256 String?
  failureCode   String?
  idempotencyKey String
  requestedAt   DateTime     @default(now())
  completedAt   DateTime?
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case          QualityCase  @relation(fields: [caseId, tenantId], references: [id, tenantId], onDelete: Cascade)
  requestedBy   User         @relation("ReportRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, caseId, requestedAt])
  @@index([tenantId, status, requestedAt])
}

model AuditEvent {
  id          String    @id @default(cuid())
  tenantId    String
  caseId      String?
  actorType   ActorType @default(USER)
  actorId     String?
  eventName   String
  entityType  String
  entityId    String
  caseVersion Int?
  reason      String?
  metadata    Json?
  requestId   String?
  jobId       String?
  createdAt   DateTime  @default(now())
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case        QualityCase? @relation(fields: [caseId, tenantId], references: [id, tenantId], onDelete: Restrict)
  actor       User?     @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, entityType, entityId, createdAt])
  @@index([tenantId, caseId, createdAt])
  @@index([tenantId, createdAt])
}

model OutboxEvent {
  id            String       @id @default(cuid())
  tenantId      String
  caseId        String?
  actorId       String?
  eventType     String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  idempotencyKey String      @unique
  lastErrorCode String?
  createdAt     DateTime     @default(now())
  dispatchedAt  DateTime?
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case          QualityCase? @relation(fields: [caseId, tenantId], references: [id, tenantId], onDelete: Restrict)
  actor         User?        @relation("OutboxActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([tenantId, createdAt])
}
