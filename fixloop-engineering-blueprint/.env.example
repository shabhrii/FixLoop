# Copy to .env.local; do not commit credentials.
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DIRECT_URL=postgresql://MIGRATION_USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
QUEUE_DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=fixloop-private
AUTH_COOKIE_SECRET=
AI_ENABLED=false
AI_PROVIDER=mock
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_MS=12000
UPLOAD_MAX_BYTES=15728640
SIGNED_URL_TTL_SECONDS=300
CRON_SECRET=
LOG_LEVEL=info
SENTRY_DSN=
